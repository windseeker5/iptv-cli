# KDTV CLI settings. Copy to .env and fill in; never commit .env.

# Your IPTV provider (Xtream Codes login). Required.
IPTV_SERVER_URL=http://provider.example:80
IPTV_USERNAME=
IPTV_PASSWORD=

# Where recordings go. When it isn't writable (an unplugged drive), data/recordings is used.
USB_RECORDS_PATH=./nginx/recordings
USB_DOWNLOADS_PATH=./data/downloads

# Jellyfin's TV folder (one sub-folder per show), for schedules that fill the library.
TVSHOW_LIBRARY_ROOT=
# Library rescans: an API key (preferred) or a login.
JELLYFIN_PUBLISHED_SERVER_URL=http://localhost:8096
JELLYFIN_API_KEY=
JELLYFIN_USERNAME=
JELLYFIN_PASSWORD=

# Recording results and pre-flight warnings.
DISCORD_WEBHOOK_URL=

# Read by the Docker stack in the DEV folder (two levels up).
NGINX_RTMP_PORT=1935
NGINX_HTTP_PORT=8080
NGINX_ADMIN_PORT=8081
JELLYFIN_HTTP_PORT=8096
JELLYFIN_HTTPS_PORT=8920
JELLYFIN_DOMAIN=
JELLYFIN_MEDIA_PATH=./media
USB_MOVIES_PATH=./media/movies
USB_MUSIC_PATH=./media/music
USB_PHOTOS_PATH=./media/photos
CADDY_DOMAIN=
LETSENCRYPT_EMAIL=
TZ=America/Toronto
