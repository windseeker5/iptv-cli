[Unit]
Description=JP: OMT agent runner (kdtv toolbox + Claude Code)
After=network-online.target docker.service

[Service]
WorkingDirectory=%h/Documents/DEV/kdtv/cli
ExecStart=%h/.local/bin/kdtv jp-runner
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
