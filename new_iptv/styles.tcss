Screen {
    background: black;
    color: white;
}

Static {
    color: white;
}

Label {
    color: white;
}

Input {
    background: #111111;
    color: white;
    border: solid white;
}

Input:focus {
    border: solid cyan;
}

ListView {
    border: solid white;
    background: black;
    color: white;
}

ListView > ListItem {
    color: white;
    background: black;
}

ListView > ListItem.--highlight {
    background: #111111;
    color: cyan;
    text-style: bold;
}

Header, Footer {
    background: #111111;
    color: white;
    text-style: bold;
}

Footer > .footer--key {
    background: black;
    color: cyan;
    text-style: bold;
}

.status-bar {
    background: #111111;
    color: white;
    height: 1;
}

.title {
    text-style: bold;
    color: cyan;
}

#results-layout {
    height: 1fr;
}

#results-list {
    width: 60%;
    height: 100%;
}

#preview-panel {
    width: 40%;
    height: 100%;
    background: #111111;
    padding: 1;
}

#favorites-list, #category-list, #service-list {
    height: 1fr;
}
